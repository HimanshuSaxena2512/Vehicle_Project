<style>
     body{margin: 0;}
      
     .maincontainer{
        width: 1376.3px;
        height: 97%;
        display: flex;
        justify-content: center;
        align-items: center;
        font-family: Lato;
        
     }

     .box{
        width: 60%;
        height: auto;
        background-color: white;
        border-radius: 25px;
        padding: 15px;
        border: 2px solid gray;
     }
   
    .heading{
        display: flex;
        flex-direction: row;
         align-items: center;
    }

    .headingstyle{
        margin-left: 10px;
        font-size: 18px;
        font-weight: bold;
    }
    
    .btncenter{
      display: flex;
      justify-content: center;
    }

    .btnsize{
      margin-top: 5px;
      width: 80%;
    }

      .add{
        width: 50px;
        height: 50px;
        border-radius: 10px;
    }


</style>

<html>
<head>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-LN+7fdVzj6u52u30Kp6M/trliBMCMKTyK833zpbD+pXdCLuTusPj697FH4R/5mcr" crossorigin="anonymous">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js" integrity="sha384-ndDqU0Gzau9qJ1lfW4pNLlhNTkCfHzAVBReH9diLvGRem5+R9g2FzA8ZGN954O5Q" crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js" integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r" crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.min.js" integrity="sha384-7qAoOXltbVP82dhxHAUje59V5r2YsVfBafyUDxEdApLPmcdhBPg1DKg1ERo0BZlK" crossorigin="anonymous"></script>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="/javascripts/project.js"></script> 
</head>

<form action="/vehicle/submit_vehicle" method="post" enctype="multipart/form-data">
  <Grid class="maincontainer">
   <Grid class="box">

      <Grid class="row">
       <Grid class="col-12">

        <Grid class="heading">
                 <Grid style="display: flex;align-items: center;">
                 <img src="/images/logo.png" width="70" />
                 <Grid class="headingstyle">Vehicle Register </Grid>
             </Grid>
             <Grid style="margin-left: auto;">
               <a href="/vehicle/display_all_vehicle"><img src="/images/list.png" class="add"/></a>
             </Grid>

        </Grid>
    
       </Grid>
      </Grid>



     <Grid class="row" style="margin-top: 10;">
         <Grid class="col-xs-12 col-sm-12 col-lg-4" style="margin-bottom: 5px;">
            <select required name="categoryid" id="categoryid" class="form-select">
             <option selected>Select Vehicle Category</option>
            </select>
         </Grid>

         <Grid class="col-xs-12 col-sm-12 col-lg-4" style="margin-bottom: 5px;">
            <select required name="subcategoryid" id="subcategoryid" class="form-select" >
            <option selected>Select Vehicle Sub-Category</option>
           </select>
         </Grid>

        <Grid class="col-xs-12 col-sm-12 col-lg-4" style="margin-bottom: 5px;">
          <input required type="text" class="form-control" name="vehiclename" id="vehiclename" placeholder="Vehicle Name">
        </Grid>

        <Grid class="row" style="margin-top: 5px;">
          <Grid class="col-lg-12">
             <textarea required class="form-control" name="features" rows="2" placeholder="Features"></textarea>
          </Grid>
        </Grid>

        <Grid class="row" style="margin-top: 10px;">
          <Grid class="col-lg-12">
             <textarea required class="form-control" name="description" rows="2" placeholder="Discription"></textarea>
          </Grid>
        </Grid>

         <Grid class="row" style="margin-top: 10px;">
          <Grid class="col-sm-12 col-xs-12 col-lg-6" style="margin-top: 5px;">
             <input required type="text" class="form-control" name="price" placeholder="Price"/>
          </Grid>
         
          <Grid class="col-sm-12 col-xs-12 col-lg-6" style="margin-top: 5px;">
             <input required type="text" class="form-control" name="offerprice"  placeholder="Offer Price"/> 
          </Grid>
        </Grid>


        <Grid class="row" style="margin-top: 10px;word-spacing: 40px;">
          <Grid class="col-xs-2.4 col-sm-2.4 col-lg-12">
            <Grid class="form-check form-check-inline">
             <input class="form-check-input" type="radio" name="vehicletype" id="vehicletype" value="One-Wheeler">
              <label class="form-check-label" for="vehicletype">One-Wheeler</label>
            </Grid>
            <Grid class="form-check form-check-inline">
             <input class="form-check-input" type="radio" name="vehicletype" id="vehicletype" value="Two-Wheeler">
              <label class="form-check-label" for="vehicletype">Two-Wheeler</label>
            </Grid>
            <Grid class="form-check form-check-inline">
             <input class="form-check-input" type="radio" name="vehicletype" id="vehicletype" value="Three-Wheeler">
              <label class="form-check-label" for="vehicletype">Three-Wheeler</label>
            </Grid>
            <Grid class="form-check form-check-inline">
             <input class="form-check-input" type="radio" name="vehicletype" id="vehicletype" value="Four-Wheeler">
              <label class="form-check-label" for="vehicletype">Four-Wheeler</label>
            </Grid>
            <Grid class="form-check form-check-inline">
             <input class="form-check-input" type="radio" name="vehicletype" id="vehicletype" value="Other">
              <label class="form-check-label" for="vehicletype">Other</label>
            </Grid>
          </Grid>

          <Grid class="col-xs-6 col-sm-6 col-lg-5" style="margin-top: 10px;">
            <select required name="status" id="status" class="form-select" >
            <option selected>Select Status</option>
            <option value="Continue">Continue</option>
            <option value="Discontinue">Discontinue</option>
           </select>
          </Grid>

          <Grid class="col-xs-6 col-sm-6 col-lg-1" style="margin-top: 10px;">
            <img id="vp"/>
          </Grid>

          <Grid class="col-xs-6 col-sm-6 col-lg-6" style="margin-top: 10px;">
             <input required onchange="showPicture()" class="form-control" type="file" name="vehiclepicture" id="vehiclepicture" /> 
          </Grid>

        </Grid>

        <Grid class="row" style="margin-top: 25px;">
           <Grid class="col-xs-12 col-sm-12 col-lg-6 btncenter" >
          <button class="btn btn-primary btnsize" type="submit">Submit</button>
         </Grid>

         <Grid class="col-xs-12 col-sm-12 col-lg-6 btncenter" >
          <button class="btn btn-primary btnsize" type="reset">Reset</button>
         </Grid>
        </Grid>
        
     </Grid>

    <Grid class="row" style="margin-top: 15px;">
      <Grid class="col-xs-12 col-sm-12 col-lg-12 btncenter" >
         <%=message %>   
      </Grid>
    </Grid>
 

</Grid>
</Grid>
</form>
</html>