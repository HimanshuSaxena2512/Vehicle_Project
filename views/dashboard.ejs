<style>
     body{margin: 0;}
      
     .maincontainer{
          
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        
        font-family: Lato;
     }

     .box{
        width: 60%;
        height: auto;
        background-color: white;
        border-radius: 25px;
        padding: 15px;
     }

     .navbar{
       width: 100%;
       height: 60px;
       background: #1e90ff;

     }

     .logostyle{
        width: 50px;
        height: 50px;
        margin: 5px;
        padding-left: 5px;
     }

     .leftBox{
       width: 170px;
       height: 400px;
       background: #2d3436;
       margin: 20px;
       padding: 10px;
       border-radius: 20px;
     }
   
    
</style>

<html>
    <head>
       
<link href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&display=swap" rel="stylesheet">
 
    </head>
    <body>

      <div class="maincontainer">
        <div class="navbar">

         <div>
            <img src="/images/logo.png" class="logostyle"/>
         </div>

        </div>
        
        <div style="display: flex;">

             <div class="leftBox">
               <div style="display: flex;flex-direction: column; justify-content: center; ">
                  <img src="/images/<%=data.picture %>" style="width: 100px; height: 100px; border-radius: 50px; align-self: center;"/>
                  <div style="color: #fff; font-weight: 500; letter-spacing: 1px; font-size: 12px; align-self: center;">
                    <%=data.adminname %>
                  </div>
                  <div style="color: #fff; font-weight: 500; letter-spacing: 1px; font-size: 10px; align-self: center;">
                    <%=data.emailid %>
                  </div>
                  <div style="color: #fff; font-weight: 500; letter-spacing: 1px; font-size: 10px; align-self: center;">
                    <%=data.mobileno%>
                  </div>
                  <div style="color: #fff; font-weight: bold;  font-size: 14px; align-self: center;margin-top: 20px;">
                     <a href="/vehicle/display_all_vehicle " target="mw" style="text-decoration: none;color: #fff;">Vehicle List</a>
                  </div>
                  <div style="color: #fff; font-weight: bold;  font-size: 14px; align-self: center;margin-top: 20px;">
                     <a href="/vehicle//vehicle_interface" target="mw" style="text-decoration: none;color: #fff;"> Add Vehicle</a>
                  </div>
                  <div style="color: #fff; font-weight: bold;  font-size: 14px; align-self: center;margin-top: 20px;">
                     <a href="/vehicle//display_all_vehicle" target="mw" style="text-decoration: none;color: #fff;"> Update Vehicle</a>
                  </div>
                  <div style="color: #fff; font-weight: bold;  font-size: 14px; align-self: center;margin-top: 20px;">
                     <a href="/admin/admin_logout"   style="text-decoration: none;color: #fff;"> Logout</a>
                  </div>

               </div>
             </div>

             <div>
                <iframe width="1400" height="620" frameborder="0" name="mw">
                    
                </iframe>
             </div>


        </div>

      </div>

    </body>
</html>