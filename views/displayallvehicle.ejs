 <html>
    <head>
        <link rel="stylesheet" href="/stylesheets/display.css" />
        <link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-LN+7fdVzj6u52u30Kp6M/trliBMCMKTyK833zpbD+pXdCLuTusPj697FH4R/5mcr" crossorigin="anonymous">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js" integrity="sha384-ndDqU0Gzau9qJ1lfW4pNLlhNTkCfHzAVBReH9diLvGRem5+R9g2FzA8ZGN954O5Q" crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js" integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r" crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.min.js" integrity="sha384-7qAoOXltbVP82dhxHAUje59V5r2YsVfBafyUDxEdApLPmcdhBPg1DKg1ERo0BZlK" crossorigin="anonymous"></script>
    </head>
    <body>
     <Grid class="maincontainer">
        <Grid class="box">
             <Grid class="heading">
                 <Grid style="display: flex;align-items: center;">
                 <img src="/images/logo.png" width="70" />
                 <Grid class="headingstyle">List of Vehicles </Grid>
             </Grid>
             <Grid style="margin-left: auto;">
               <a href="/vehicle/vehicle_interface"><img src="/images/add.png" class="add"/></a> 
             </Grid>

        </Grid>
    <table class="table">
        <tr>
            <th>Sn</th>
            <th>Vehicle Id</th>
            <th>Category</th>
            <th>Vehicle Name</th>
            <th>Vehicle Type</th>
            <th>Features</th>
            <th>Description</th>
            <th>Price</th>
            <th>Status</th>
            <th>Picture</th>
            <th>Edit</th>
        </tr>
    <%
    data.map((item,i)=>{%>
    <tr>
        <td><%=i+1 %></td>
        <td><%=item.vehicleid %></td>
        <td><%=item.categoryname %><br><%=item.subcategoryname %></td>
        <td><%= item.vehiclename %></td>
        <td><%=item.vehicletype %></td>
        <td><%= item.features %></td>
        <td><%= item.description %></td>
        <td><s>&#8377;</><%= item.price %></s><br>&#8377;</><%=item.offerprice%></td>
        <td><%= item.status %></td>
        <td><a href="/vehicle/show_picture?vehicleid=<%=item.vehicleid%>&vehiclename=<%=item.vehiclename %>&vehiclepicture=<%=item.vehiclepicture%>"><img src='/images/<%= item.vehiclepicture %>' class="pic"/></a></td>
        <td><a href="/vehicle/show_vehicle?vehicleid=<%=item.vehicleid %>"><button type="button" class="btn btn-warning">Update</button></a></td>
        
    </tr>
    <% }) %>
    </table>
    </Grid>
    </Grid>

    </body>

</html>